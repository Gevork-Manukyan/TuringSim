{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* CSS Modules */
    "esModuleInterop": true,

    /* Only auto-include these global type packages. Without this, TS pulls in
       every @types/* folder — including @types/react-native (a transitive dep
       of @types/styled-components) — which fails the build with TS2688.
       Do not list "node" here: @types/node is only an *optional peer* of vite,
       so a clean CI install omits it and tsc fails with TS2688 for 'node'. No
       source file uses node globals. */
    "types": ["react", "react-dom", "styled-components"],
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
